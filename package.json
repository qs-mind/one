{
  "name": "qs-mind-one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test:ui": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "perf:canvas": "playwright test --project=perf",
    "bench": "node scripts/bench.mjs",
    "test:bench": "playwright test --config playwright.bench.config.ts",
    "test:core": "node scripts/python.mjs -m pytest core",
    "test:release": "vitest run scripts/release.test.mjs scripts/version.test.mjs",
    "lint:core": "node scripts/python.mjs -m ruff check core && node scripts/python.mjs -m ruff format --check core",
    "package:core": "node scripts/package-core.mjs",
    "smoke:core": "node scripts/smoke-core.mjs",
    "notices": "node scripts/notices.mjs",
    "version": "node scripts/version.mjs",
    "package": "npm run package:core && npm run smoke:core && tauri build --config desktop/tauri.release.conf.json -- --locked",
    "sandbox:fetch": "node scripts/python.mjs -m qsone.sandbox.runtime",
    "check": "npm run typecheck && npm run lint:core && cargo clippy --manifest-path desktop/Cargo.toml -- -D warnings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.325",
    "@fontsource-variable/kumbh-sans": "5.3.0",
    "@fontsource/zain": "5.3.0",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/comment": "53.0.0",
    "@platejs/list": "53.3.13",
    "@platejs/suggestion": "53.2.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-direction": "1.2.0",
    "@radix-ui/react-popover": "1.3.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@xyflow/react": "12.12.1",
    "ai": "6.0.322",
    "cmdk": "1.1.1",
    "platejs": "53.5.2",
    "react": "19.3.1",
    "react-data-grid": "7.0.0-beta.63",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
