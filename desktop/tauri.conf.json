{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QS Mind ONE",
  "version": "0.1.0",
  "identifier": "app.qsmind.one",
  "build": {
    "devUrl": "http://localhost:1440",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QS Mind ONE",
        "center": true,
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
